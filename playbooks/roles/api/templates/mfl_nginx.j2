{% extends 'nginx/templates/nginx.site.conf.j2' %}

{% macro locations -%}
    location /static {
        alias /opt/mfl_api/static;
    }

    location /media {
        alias /opt/mfl_api/media;
    }

    location / {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_redirect off;

        if (!-f $request_filename) {
            proxy_pass   http://app_server;
            break;
        }
    }
{%- endmacro %}

{% block upstreams %}
upstream app_server {
    server 127.0.0.1:8000 fail_timeout=0;
}
{% endblock upstreams %}

{% block http_locations %}{{ locations() }}{% endblock http_locations %}

{% block https_locations %}{{ locations() }}{% endblock https_locations %}
