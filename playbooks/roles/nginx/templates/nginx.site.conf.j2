{% block upstreams %}{% endblock upstreams %}
server {
    listen 80;
    server_name {{server_name}};

    access_log /var/log/nginx/{{server_name}}-http-access.log combined;
    error_log /var/log/nginx/{{server_name}}-http-error.log;

    gzip on;
    gzip_types  application/javascript application/font-woff text/javascript text/plain application/x-javascript text/xml text/css;
    gzip_vary on;
    gzip_disable "MSIE [1-6]\.(?!.*SV1)";

    sendfile on;

    keepalive_timeout 5;

    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";

    {% if ssl_on %}
    ## redirect http to https ##
    rewrite ^ https://$server_name$request_uri? permanent;
    {% else %}
    {% block http_locations %}{% endblock http_locations %}
    {% endif %}
}

{% if ssl_on %}
server {
    listen 443 ssl;
    server_name {{server_name}};

    access_log /var/log/nginx/{{server_name}}-https-access.log;
    error_log /var/log/nginx/{{server_name}}-https-error.log;

    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";

    ssl_certificate {{web_ssl.cert.dest}} ;
    ssl_certificate_key {{web_ssl.key.dest}} ;
    ssl_protocols TLSv1 TLSv1.1 TLSv1.2;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-SHA:AES128-SHA;

    {% block https_locations %}{% endblock https_locations %}
}
{% endif %}
